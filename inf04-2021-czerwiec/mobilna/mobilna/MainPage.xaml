<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="mobilna.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Label
                Background="#008080"
                Text="Rejestruj konto"
                TextColor="white" />
            <Label Text="Podaj e-email:" />
            <Entry x:Name="emailEntry" />
            <Label Text="Podaj hasło:" />
            <Entry IsPassword="True" x:Name="passwordEntry" />
            <Label Text="Powtorz hasło:" />
            <Entry IsPassword="True" x:Name="repeatPasswordEntry" />
            <Button
                Clicked="register"
                FontSize="15"
                Text="Zarejestruj" />
            <Label x:Name="registerLabel" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
