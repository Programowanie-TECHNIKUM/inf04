<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    BackgroundColor="#5F9EA0"
    x:Class="MauiApp1.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="18">

            <Label
                FontSize="16"
                Text="Podaj wartość klucza"
                TextColor="#FAEBD7" />

            <Entry
                Keyboard="Numeric"
                Placeholder="Wpisz liczbę (np. 3)"
                x:Name="key" />

            <Label
                FontSize="16"
                Text="Podaj tekst"
                TextColor="#FAEBD7" />

            <Editor
                AutoSize="TextChanges"
                BackgroundColor="White"
                HeightRequest="140"
                TextColor="Black"
                x:Name="value" />

            <Button
                BackgroundColor="#ADD8E6"
                Clicked="cryptEvent"
                CornerRadius="6"
                HeightRequest="44"
                Text="Zaszyfruj"
                TextColor="Black" />

            <Label
                FontSize="16"
                Text="Tekst zaszyfrowany"
                TextColor="#FAEBD7" />

            <Border
                BackgroundColor="Transparent"
                Padding="10"
                Stroke="#FAEBD7"
                StrokeThickness="1">
                <Label
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    TextColor="#F0F8FF"
                    x:Name="encryptedValueLabel" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>